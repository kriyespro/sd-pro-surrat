{% extends 'base.jinja' %}
{% block title %}Password Reset Complete{% endblock %}
{% block nav %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<div class="auth-page-bg"></div>
<nav class="relative z-10 flex items-center justify-between px-[5%] h-16 auth-nav-bar">
  <a href="{{ url('home') }}" class="logo" style="font-family:'Playfair Display',serif;font-size:1.55rem;font-weight:900;color:var(--white)">Surat<span style="color:var(--gold)">Pro</span></a>
</nav>
<main class="relative z-10 min-h-[calc(100vh-64px)] flex items-center justify-center px-4 py-12">
  <div class="auth-card w-full max-w-md p-6 md:p-8 text-center">
    <div style="font-size:2.5rem;margin-bottom:1rem">✅</div>
    <h1 class="text-xl font-bold mb-2" style="font-family:'Playfair Display',serif">Password changed!</h1>
    <p class="text-sm mb-6" style="color:var(--text-muted)">Your password has been set. You can now log in.</p>
    <a href="{{ url('login') }}" class="sp-btn-gold" style="width:100%;justify-content:center">Log In →</a>
  </div>
</main>
{% endblock %}

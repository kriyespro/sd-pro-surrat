{% extends 'base.jinja' %}
{% block title %}Login{% endblock %}
{% block meta_desc %}Login or register on SuratPro{% endblock %}
{% block extra_head %}
<style>
.logo{font-family:'Playfair Display',serif;font-size:1.55rem;font-weight:900;color:var(--white)}
.logo span{color:var(--gold)}
.tab-btn{flex:1;padding:0.7rem;border:none;background:transparent;color:var(--text-muted);font-size:0.88rem;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;transition:all 0.2s}
.tab-btn.active{color:var(--gold);border-bottom-color:var(--gold)}
</style>
{% endblock %}
{% block nav %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<div class="auth-page-bg"></div>
<div class="auth-geo-lines"></div>
<nav class="relative z-10 flex items-center justify-between px-[5%] h-16 auth-nav-bar">
  <a href="{{ url('home') }}" class="logo">Surat<span>Pro</span></a>
  <a href="{{ url('home') }}" class="text-sm text-[var(--text-muted)] hover:text-[var(--gold)] transition-colors">← Back to Home</a>
</nav>

<main class="relative z-10 min-h-[calc(100vh-64px)] flex items-center justify-center px-4 py-12" x-data="{tab: '{{ tab|default('login') }}'}">
  <div class="auth-card w-full max-w-2xl p-6 md:p-8">
    <div class="text-center mb-6">
      <span class="logo text-2xl">Surat<span>Pro</span></span>
      <p class="text-[var(--text-muted)] text-sm mt-2">Surat's #1 Freelance Marketplace</p>
    </div>

    <div class="flex auth-tab-row mb-6">
      <button type="button" class="tab-btn" :class="tab === 'login' ? 'active' : ''" @click="tab='login'">
        Login
      </button>
      <button type="button" class="tab-btn" :class="tab === 'register' ? 'active' : ''" @click="tab='register'">
        Register
      </button>
    </div>

    {% if GOOGLE_LOGIN_ENABLED %}
    <a href="{{ url('google_login_start') }}"
       class="flex items-center justify-center gap-3 w-full py-3 mb-5 rounded-xl border border-[var(--border)] bg-white/5 hover:bg-white/10 transition-colors text-sm font-semibold text-[var(--white)]">
      <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303C33.654 32.657 29.183 36 24 36c-5.514 0-10-4.486-10-10s4.486-10 10-10c2.837 0 5.402 1.192 7.207 3.093l5.657-5.657C33.64 10.053 28.991 8 24 8 14.059 8 6 16.059 6 26s8.059 18 18 18 18-8.059 18-18c0-1.341-.138-2.65-.389-3.917z"/><path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 16.108 18.961 13 24 13c2.837 0 5.402 1.192 7.207 3.093l5.657-5.657C33.64 10.053 28.991 8 24 8 16.318 8 9.656 12.337 6.306 14.691z"/><path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/><path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a18.04 18.04 0 0 1-6.087 5.571l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/></svg>
      Continue with Google
    </a>
    <div class="flex items-center gap-3 mb-5">
      <div class="flex-1 h-px bg-[var(--border)]"></div>
      <span class="text-xs text-[var(--text-muted)] uppercase tracking-wider">or email</span>
      <div class="flex-1 h-px bg-[var(--border)]"></div>
    </div>
    {% endif %}

    <div x-show="tab === 'login'" id="login-form-wrap">
      {% set form = login_form %}
      {% include 'partials/_login_form.jinja' %}
    </div>

    <div x-show="tab === 'register'" id="register-form-wrap">
      {% set form = reg_form %}
      {% include 'partials/_register_form.jinja' %}
    </div>
  </div>
</main>
{% endblock %}

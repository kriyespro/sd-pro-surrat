<form
  method="post"
  action="{{ url('login') }}{% if next %}?next={{ next }}{% endif %}"
  hx-post="{{ url('login') }}{% if next %}?next={{ next }}{% endif %}"
  hx-target="#login-form-wrap"
  hx-swap="innerHTML"
  class="space-y-4"
>
  <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
  {% if next %}<input type="hidden" name="next" value="{{ next }}">{% endif %}
  {% if form and form.non_field_errors() %}
    <div class="text-sm text-red-300 mb-2">
      {% for error in form.non_field_errors() %}
        <p>{{ error }}</p>
      {% endfor %}
    </div>
  {% endif %}

  <div>
    <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">Username</label>
    <input class="sp-field w-full input-field" type="text" name="username" value="{{ form.username.value() if form else '' }}" required autocomplete="username">
    {% if form and form.username.errors %}
      {% for err in form.username.errors %}<p class="sp-error">{{ err }}</p>{% endfor %}
    {% endif %}
  </div>

  <div>
    <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">Password</label>
    <input class="sp-field w-full input-field" type="password" name="password" required autocomplete="current-password">
    {% if form and form.password.errors %}
      {% for err in form.password.errors %}<p class="sp-error">{{ err }}</p>{% endfor %}
    {% endif %}
  </div>

  <div class="flex justify-between items-center" style="margin-top:-0.25rem">
    <span></span>
    <a href="/auth/password-reset/" class="text-xs" style="color:var(--gold)">Forgot password?</a>
  </div>

  <button type="submit" class="sp-btn-gold w-full btn-auth">Login →</button>
</form>

{% extends 'base.jinja' %}
{% block title %}Edit Profile{% endblock %}
{% block meta_desc %}Edit your SuratPro profile{% endblock %}

{% block content %}
<main class="max-w-4xl mx-auto px-4 py-8">
  <div class="sp-card p-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="sp-heading text-2xl font-bold">Edit Profile</h1>
      <a href="{{ url('dashboard') }}" class="sp-btn-ghost">Back to dashboard</a>
    </div>

    <form method="post" enctype="multipart/form-data" class="space-y-5">
      <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">

      <h2 class="font-semibold text-lg">Basic details</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {% for field in user_form %}
          <div class="{% if field.name == 'bio' %}md:col-span-2{% endif %}">
            <label class="block text-sm mb-1">{{ field.label }}</label>
            {{ field }}
            {% if field.errors %}
              <p class="text-red-300 text-xs mt-1">{{ field.errors|join(', ') }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      {% if fl_form %}
        <h2 class="font-semibold text-lg pt-2">Freelancer details</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {% for field in fl_form %}
            <div>
              <label class="block text-sm mb-1">{{ field.label }}</label>
              {{ field }}
              {% if field.errors %}
                <p class="text-red-300 text-xs mt-1">{{ field.errors|join(', ') }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <div class="flex gap-3 pt-2">
        <button type="submit" class="sp-btn-gold">Save profile</button>
        <a href="{{ url('dashboard') }}" class="sp-btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</main>
{% endblock %}

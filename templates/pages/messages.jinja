{% extends 'base.jinja' %}
{% block title %}Messages{% endblock %}
{% block meta_desc %}Your messages on SuratPro{% endblock %}

{% block body_class %}page-messages{% endblock %}
{% block extra_head %}{% endblock %}

{% block nav %}
  {% include 'components/nav.jinja' %}
{% endblock %}

{% block footer %}{% endblock %}

{% block content %}
<div x-data="messagesApp()">
<div class="messages-shell">
<div class="chat-wrap">
  <!-- Thread List -->
  <div class="thread-list">
    <div class="thread-search">
      <input type="text" placeholder="Search conversations…" x-model="search">
    </div>
    <div style="overflow-y:auto;flex:1">
      <template x-for="t in threads.filter(t=>t.name.toLowerCase().includes(search.toLowerCase()))" :key="t.id">
        <div class="thread-item" :class="{active:activeThread===t.id}" @click="activeThread=t.id;t.unread=false">
          <div class="avatar" :style="'background:'+t.color" x-text="t.initials"></div>
          <div style="flex:1;min-width:0">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.2rem">
              <span style="font-size:0.88rem;font-weight:600" x-text="t.name"></span>
              <span style="font-size:0.65rem;color:var(--text-dim)" x-text="t.time"></span>
            </div>
            <div style="font-size:0.75rem;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis" x-text="t.lastMsg"></div>
          </div>
          <div x-show="t.unread" class="unread-dot"></div>
        </div>
      </template>
    </div>
  </div>

  <!-- Chat Window -->
  <div class="chat-window">
    <template x-if="activeThread">
      <div style="display:flex;flex-direction:column;height:100%">
        <!-- Header -->
        <div class="chat-header">
          <div class="avatar" :style="'background:'+currentThread.color" x-text="currentThread.initials" style="width:42px;height:42px"></div>
          <div style="flex:1">
            <div style="font-weight:600;font-size:0.95rem" x-text="currentThread.name"></div>
            <div style="font-size:0.72rem;color:var(--green)">🟢 Online · <span x-text="currentThread.title"></span></div>
          </div>
          <div style="display:flex;gap:0.5rem">
            <div class="icon-btn" title="Video call">📹</div>
            <a class="icon-btn" title="View profile" :href="currentThread.profileUrl || '/browse/'">👤</a>
            <div class="icon-btn" title="More options">⋯</div>
          </div>
        </div>

        <!-- Messages -->
        <div class="chat-messages" x-ref="msgArea">
          <!-- Date divider -->
          <div style="text-align:center;font-size:0.7rem;color:var(--text-dim);margin:0.5rem 0">
            <span class="messages-divider-pill">Today</span>
          </div>
          <template x-for="(m,i) in currentMessages" :key="i">
            <div class="msg" :class="{mine:m.mine}">
              <div x-show="!m.mine" class="avatar" :style="'background:'+currentThread.color+';width:32px;height:32px;font-size:0.72rem'" x-text="currentThread.initials"></div>
              <div>
                <div class="bubble" :class="m.mine?'mine':'theirs'" x-text="m.text"></div>
                <div class="msg-time" :style="m.mine?'text-align:right':''" x-text="m.time"></div>
              </div>
            </div>
          </template>
          <!-- Typing indicator -->
          <div x-show="typing" class="msg" style="max-width:120px">
            <div class="avatar" :style="'background:'+currentThread.color+';width:32px;height:32px;font-size:0.72rem'" x-text="currentThread.initials"></div>
            <div class="bubble theirs" style="padding:0.7rem 1rem">
              <span style="display:inline-flex;gap:3px">
                <span style="width:6px;height:6px;border-radius:50%;background:var(--text-muted);animation:sp-bounce-msg 1s 0s infinite">.</span>
                <span style="width:6px;height:6px;border-radius:50%;background:var(--text-muted);animation:sp-bounce-msg 1s 0.2s infinite">.</span>
                <span style="width:6px;height:6px;border-radius:50%;background:var(--text-muted);animation:sp-bounce-msg 1s 0.4s infinite">.</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Input -->
        <div class="chat-input-bar">
          <div class="icon-btn" title="Attach file">📎</div>
          <textarea class="chat-input" placeholder="Type a message…" x-model="newMsg" @keydown.enter.prevent="sendMessage()" rows="1"></textarea>
          <button class="send-btn" @click="sendMessage()">Send ↗</button>
        </div>
      </div>
    </template>

    <!-- Empty state -->
    <div x-show="!activeThread" style="flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;color:var(--text-muted)">
      <div style="font-size:3rem">💬</div>
      <div style="font-size:0.95rem">Select a conversation to start chatting</div>
    </div>
  </div>

  <!-- Info Panel -->
  <div class="info-panel" x-show="activeThread">
    <template x-if="activeThread">
      <div>
        <div style="text-align:center;margin-bottom:1rem">
          <div class="avatar" :style="'background:'+currentThread.color+';width:64px;height:64px;font-size:1.3rem;margin:0 auto 0.7rem'" x-text="currentThread.initials"></div>
          <div style="font-weight:600;font-size:0.95rem" x-text="currentThread.name"></div>
          <div style="font-size:0.75rem;color:var(--text-muted)" x-text="currentThread.title"></div>
        </div>
        <a :href="currentThread.profileUrl || '/browse/'" style="display:block;text-align:center;padding:0.6rem;background:var(--gold-dim);border:1px solid var(--border-gold);color:var(--gold);border-radius:8px;font-size:0.82rem;font-weight:600;text-decoration:none;margin-bottom:1rem">View Profile →</a>
        <div style="background:var(--mid);border:1px solid var(--border);border-radius:10px;padding:0.9rem">
          <p style="font-size:0.65rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);margin-bottom:0.7rem;font-family:'Space Mono',monospace">// Contract Info</p>
          <div style="display:flex;flex-direction:column;gap:0.45rem;font-size:0.8rem;color:var(--text-muted)">
            <div>Status: <strong style="color:var(--green)">Active</strong></div>
            <div>Budget: <strong style="color:var(--white)">₹45,000</strong></div>
            <div>Deadline: <strong style="color:var(--white)">May 15, 2026</strong></div>
            <div>In Escrow: <strong style="color:var(--gold)">₹15,000</strong></div>
          </div>
        </div>
      </div>
    </template>
  </div>
</div>
</div>
</div>

<script>
function messagesApp() {
  const seededThreads = {{ threads_json|safe }};
  const seededMessages = {{ messages_json|safe }};
  const initialThread = {{ active_thread_id|default('null') }};
  return {
    search: '', activeThread: initialThread, newMsg: '', typing: false,
    threads: seededThreads,
    messages: seededMessages,
    get currentThread() { return this.threads.find(t=>t.id===this.activeThread) || null; },
    get currentMessages() { return this.messages[this.activeThread] || []; },
    sendMessage() {
      if(!this.newMsg.trim()) return;
      if(!this.messages[this.activeThread]) this.messages[this.activeThread]=[];
      this.messages[this.activeThread].push({mine:true,text:this.newMsg.trim(),time:'Just now'});
      this.newMsg='';
      this.typing=true;
      setTimeout(()=>{
        this.typing=false;
        const replies=['Got it, I\'ll get on that right away!','Perfect, will do!','Thanks for the update!','Sure, let me check and get back to you.'];
        this.messages[this.activeThread].push({mine:false,text:replies[Math.floor(Math.random()*replies.length)],time:'Just now'});
      },1800);
    }
  }
}
</script>
{% endblock %}

{% extends 'base.jinja' %}
{% block title %}Reset Password{% endblock %}
{% block nav %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<div class="auth-page-bg"></div>
<nav class="relative z-10 flex items-center justify-between px-[5%] h-16 auth-nav-bar">
  <a href="{{ url('home') }}" class="logo" style="font-family:'Playfair Display',serif;font-size:1.55rem;font-weight:900;color:var(--white)">Surat<span style="color:var(--gold)">Pro</span></a>
  <a href="{{ url('login') }}" class="text-sm" style="color:var(--text-muted)">← Back to Login</a>
</nav>
<main class="relative z-10 min-h-[calc(100vh-64px)] flex items-center justify-center px-4 py-12">
  <div class="auth-card w-full max-w-md p-6 md:p-8">
    <h1 class="text-xl font-bold mb-2" style="font-family:'Playfair Display',serif">Reset your password</h1>
    <p class="text-sm mb-6" style="color:var(--text-muted)">Enter your email and we'll send a reset link.</p>
    <form method="post" class="space-y-4">
      <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
      <div>
        <label class="sp-label-text">Email</label>
        <input class="sp-field" type="email" name="email" required autocomplete="email">
      </div>
      <button type="submit" class="sp-btn-gold w-full" style="width:100%;justify-content:center">Send Reset Link →</button>
    </form>
  </div>
</main>
{% endblock %}

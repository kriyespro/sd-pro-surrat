{% for fl in freelancers %}
  <article class="sp-card p-4 mb-3">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h3 class="font-semibold text-lg">{{ fl.user.get_full_name() or fl.user.username }}</h3>
        <p class="text-sm text-[var(--text-muted)]">{{ fl.title }}</p>
      </div>
      <span class="sp-badge">★ {{ fl.avg_rating }}</span>
    </div>
    <div class="text-sm mt-3 text-[var(--text-muted)]">₹{{ fl.hourly_rate }}/hr • {{ fl.experience_years }} yrs</div>
  </article>
{% else %}
  <p class="text-[var(--text-muted)]">No freelancers found for current filter.</p>
{% endfor %}

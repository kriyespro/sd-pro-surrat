<form
  method="post"
  action="{{ url('register') }}"
  hx-post="{{ url('register') }}"
  hx-target="#register-form-wrap"
  hx-swap="innerHTML"
  class="space-y-4"
  id="reg-form"
>
  <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
  <input type="hidden" name="role" id="reg-role-input" value="{{ form.role.value() if form and form.role.value() else 'client' }}">

  {% if form and form.non_field_errors() %}
    <div class="text-sm text-red-300 mb-2">
      {% for error in form.non_field_errors() %}
        <p>{{ error }}</p>
      {% endfor %}
    </div>
  {% endif %}

  <div>
    <p class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider mb-2">I want to…</p>
    <div class="grid grid-cols-2 gap-2">
      <button type="button" class="role-btn" id="role-btn-client" onclick="setRole('client')">
        🏢 Hire Talent
      </button>
      <button type="button" class="role-btn" id="role-btn-freelancer" onclick="setRole('freelancer')">
        💼 Find Work
      </button>
    </div>
  </div>

  <script>
  function setRole(r) {
    document.getElementById('reg-role-input').value = r;
    document.querySelectorAll('.role-btn').forEach(function(b){ b.classList.remove('active'); });
    document.getElementById('role-btn-' + r).classList.add('active');
  }
  (function(){ setRole(document.getElementById('reg-role-input').value || 'client'); })();
  </script>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">First Name</label>
      <input class="sp-field input-field w-full" type="text" name="first_name" value="{{ form.first_name.value() if form else '' }}" required autocomplete="given-name">
      {% if form and form.first_name.errors %}{% for e in form.first_name.errors %}<p class="sp-error">{{ e }}</p>{% endfor %}{% endif %}
    </div>
    <div>
      <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">Last Name</label>
      <input class="sp-field input-field w-full" type="text" name="last_name" value="{{ form.last_name.value() if form else '' }}" required autocomplete="family-name">
      {% if form and form.last_name.errors %}{% for e in form.last_name.errors %}<p class="sp-error">{{ e }}</p>{% endfor %}{% endif %}
    </div>
  </div>

  <div>
    <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">Username</label>
    <input class="sp-field input-field w-full" type="text" name="username" value="{{ form.username.value() if form else '' }}" required autocomplete="username">
    {% if form and form.username.errors %}{% for e in form.username.errors %}<p class="sp-error">{{ e }}</p>{% endfor %}{% endif %}
  </div>

  <div>
    <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">Email</label>
    <input class="sp-field input-field w-full" type="email" name="email" value="{{ form.email.value() if form else '' }}" required autocomplete="email">
    {% if form and form.email.errors %}{% for e in form.email.errors %}<p class="sp-error">{{ e }}</p>{% endfor %}{% endif %}
  </div>

  <div>
    <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">Mobile</label>
    <input class="sp-field input-field w-full" type="tel" name="phone" value="{{ form.phone.value() if form else '' }}" autocomplete="tel">
    {% if form and form.phone.errors %}{% for e in form.phone.errors %}<p class="sp-error">{{ e }}</p>{% endfor %}{% endif %}
  </div>

  <div>
    <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">Password</label>
    <input class="sp-field input-field w-full" type="password" name="password1" required autocomplete="new-password">
    {% if form and form.password1.errors %}{% for e in form.password1.errors %}<p class="sp-error">{{ e }}</p>{% endfor %}{% endif %}
  </div>

  <div>
    <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">Confirm password</label>
    <input class="sp-field input-field w-full" type="password" name="password2" required autocomplete="new-password">
    {% if form and form.password2.errors %}{% for e in form.password2.errors %}<p class="sp-error">{{ e }}</p>{% endfor %}{% endif %}
  </div>

  <button type="submit" class="sp-btn-gold btn-auth w-full">Create Account →</button>
</form>

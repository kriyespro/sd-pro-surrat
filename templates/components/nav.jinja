<nav class="sp-nav">
  <a href="{{ url('home') }}" class="sp-logo">Surat<span>Pro</span></a>
  <div style="display:flex;align-items:center;gap:1.5rem">
    <a href="{{ url('browse') }}" class="sp-nav-link">Find Talent</a>
    <a href="{{ url('jobs_list') }}" class="sp-nav-link">Find Work</a>
    <a href="/pricing/" class="sp-nav-link">Pricing</a>
  </div>
  <div style="display:flex;gap:0.7rem;align-items:center">
    <span id="theme-label" style="font-size:0.78rem;color:var(--text-muted);min-width:42px;text-align:right">Light</span>
    <button type="button" class="sp-theme-toggle" data-theme-toggle title="Toggle cream theme">◐</button>
    {% if request.user.is_authenticated %}
      <a href="{{ url('dashboard') }}" class="sp-btn-outline" style="padding:0.5rem 1rem;font-size:0.82rem">Dashboard</a>
      <form method="post" action="{{ url('logout') }}" style="display:inline">
        <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
        <button type="submit" class="sp-btn-ghost" style="padding:0.5rem 1rem;font-size:0.82rem">Sign Out</button>
      </form>
      <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#0D6E6E,#E8A830);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;color:var(--dark)">
        {{ request.user.initials }}
      </div>
    {% else %}
      <a href="{{ url('login') }}" class="sp-btn-outline" style="padding:0.5rem 1rem;font-size:0.82rem">Log In</a>
      <a href="{{ url('register') }}" class="sp-btn-gold" style="padding:0.5rem 1rem;font-size:0.82rem">Get Started →</a>
    {% endif %}
  </div>
</nav>

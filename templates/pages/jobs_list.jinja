{% extends 'base.jinja' %}
{% block title %}Find Work — SuratPro{% endblock %}

{% block extra_head %}
<style>
.job-board { max-width: 960px; margin: 0 auto; padding: 2.5rem 4%; }
.jb-header { margin-bottom: 2rem; }
.jb-header h1 { font-family:'Playfair Display',serif; font-size: 2rem; font-weight: 900; color: var(--white); }
.jb-header p { color: var(--text-muted); font-size: 0.88rem; margin-top: 0.4rem; }
.jb-filters { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-bottom: 1.8rem; }
.jb-search { flex: 1; min-width: 220px; padding: 0.65rem 1rem; background: var(--mid); border: 1px solid var(--border); border-radius: 10px; color: var(--white); font-size: 0.88rem; outline: none; }
.jb-search:focus { border-color: var(--gold); }
.jb-select { padding: 0.65rem 1rem; background: var(--mid); border: 1px solid var(--border); border-radius: 10px; color: var(--white); font-size: 0.88rem; outline: none; cursor: pointer; }
.jb-select:focus { border-color: var(--gold); }
.jb-card { background: var(--mid); border: 1px solid var(--border); border-radius: 16px; padding: 1.4rem 1.6rem; margin-bottom: 1rem; transition: all 0.2s; text-decoration: none; color: inherit; display: block; }
.jb-card:hover { border-color: var(--border-gold); transform: translateY(-2px); box-shadow: var(--shadow-md); }
.jb-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
.jb-title { font-size: 1.05rem; font-weight: 700; color: var(--white); margin-bottom: 0.3rem; }
.jb-client { font-size: 0.78rem; color: var(--text-muted); }
.jb-budget { font-family:'Space Mono',monospace; font-size: 1rem; font-weight: 700; color: var(--gold); white-space: nowrap; }
.jb-desc { font-size: 0.84rem; color: var(--text-muted); line-height: 1.6; margin: 0.8rem 0; }
.jb-meta { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; margin-top: 0.8rem; }
.jb-chip { display: inline-flex; align-items: center; padding: 0.2rem 0.6rem; border-radius: 100px; font-size: 0.72rem; font-weight: 600; background: var(--chip-bg); border: 1px solid var(--border); color: var(--text-muted); }
.jb-chip.gold { border-color: var(--border-gold); color: var(--gold); background: var(--gold-dim); }
.jb-empty { text-align: center; padding: 4rem 2rem; color: var(--text-muted); }
.jb-empty h3 { font-size: 1.2rem; margin-bottom: 0.5rem; color: var(--white); }
</style>
{% endblock %}

{% block content %}
<div class="job-board">
  <div class="jb-header">
    <h1>Find Work</h1>
    <p>{{ jobs|length }} active job{{ 's' if jobs|length != 1 }} open for proposals</p>
  </div>

  <form method="get" class="jb-filters">
    <input type="text" name="q" value="{{ q }}" placeholder="Search jobs…" class="jb-search">
    <select name="category" class="jb-select" onchange="this.form.submit()">
      <option value="">All categories</option>
      {% for cat in categories %}
        <option value="{{ cat.name }}" {% if selected_category == cat.name %}selected{% endif %}>{{ cat.name }}</option>
      {% endfor %}
    </select>
    <button type="submit" class="sp-btn-gold" style="padding:0.65rem 1.2rem;font-size:0.85rem">Search</button>
    {% if q or selected_category %}
      <a href="{{ url('jobs_list') }}" style="padding:0.65rem 0.8rem;font-size:0.8rem;color:var(--text-muted);text-decoration:none">Clear</a>
    {% endif %}
  </form>

  {% if jobs %}
    {% for job in jobs %}
    <a href="{{ url('job_detail', job_id=job.id) }}" class="jb-card">
      <div class="jb-card-top">
        <div>
          <div class="jb-title">{{ job.title }}</div>
          <div class="jb-client">by {{ job.client.get_full_name() or job.client.username }} · posted {{ job.created_at.strftime('%d %b %Y') }}</div>
        </div>
        <div class="jb-budget">
          {% if job.pricing_type == 'hourly' %}
            ₹{{ job.budget_min }}–{{ job.budget_max }}<span style="font-size:0.7rem;color:var(--text-muted)">/hr</span>
          {% else %}
            ₹{{ job.budget_min }}–{{ job.budget_max }}
          {% endif %}
        </div>
      </div>
      <p class="jb-desc">{{ job.description[:200] }}{% if job.description|length > 200 %}…{% endif %}</p>
      <div class="jb-meta">
        {% if job.category %}<span class="jb-chip gold">{{ job.category.name }}</span>{% endif %}
        <span class="jb-chip">{{ job.experience_level|title }} level</span>
        <span class="jb-chip">{{ job.proposals.count() }} proposal{{ 's' if job.proposals.count() != 1 }}</span>
        {% if job.deadline %}<span class="jb-chip">Due {{ job.deadline }}</span>{% endif %}
        {% for skill in job.skills.all()[:4] %}
          <span class="jb-chip">{{ skill.name }}</span>
        {% endfor %}
      </div>
    </a>
    {% endfor %}
  {% else %}
    <div class="jb-empty">
      <h3>No jobs found</h3>
      <p>Try a different search or check back later.</p>
    </div>
  {% endif %}
</div>
{% endblock %}

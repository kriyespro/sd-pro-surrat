<form
  method="post"
  action="{{ url('login') }}"
  hx-post="{{ url('login') }}"
  hx-target="#login-form-wrap"
  hx-swap="innerHTML"
  class="space-y-4"
>
  <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
  {% if form and form.non_field_errors() %}
    <div class="text-sm text-red-300 mb-2">
      {% for error in form.non_field_errors() %}
        <p>{{ error }}</p>
      {% endfor %}
    </div>
  {% endif %}

  <div>
    <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">Username</label>
    <input class="sp-field w-full input-field" type="text" name="username" value="{{ form.username.value() if form else '' }}" required>
  </div>

  <div>
    <label class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">Password</label>
    <input class="sp-field w-full input-field" type="password" name="password" required>
  </div>

  <button type="submit" class="sp-btn-gold w-full btn-auth">Login →</button>
</form>

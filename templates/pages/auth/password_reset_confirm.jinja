{% extends 'base.jinja' %}
{% block title %}Set New Password{% endblock %}
{% block nav %}{% endblock %}
{% block footer %}{% endblock %}

{% block content %}
<div class="auth-page-bg"></div>
<nav class="relative z-10 flex items-center justify-between px-[5%] h-16 auth-nav-bar">
  <a href="{{ url('home') }}" class="logo" style="font-family:'Playfair Display',serif;font-size:1.55rem;font-weight:900;color:var(--white)">Surat<span style="color:var(--gold)">Pro</span></a>
</nav>
<main class="relative z-10 min-h-[calc(100vh-64px)] flex items-center justify-center px-4 py-12">
  <div class="auth-card w-full max-w-md p-6 md:p-8">
    <h1 class="text-xl font-bold mb-6" style="font-family:'Playfair Display',serif">Set new password</h1>
    {% if validlink %}
    <form method="post" class="space-y-4">
      <input type="hidden" name="csrfmiddlewaretoken" value="{{ csrf_token }}">
      {% for field in form %}
        <div>
          <label class="sp-label-text">{{ field.label }}</label>
          {{ field }}
          {% for err in field.errors %}<p class="sp-error">{{ err }}</p>{% endfor %}
        </div>
      {% endfor %}
      <button type="submit" class="sp-btn-gold" style="width:100%;justify-content:center">Set Password →</button>
    </form>
    {% else %}
    <p style="color:var(--saffron)">This reset link is invalid or has expired. <a href="{{ url('password_reset') }}" style="color:var(--gold)">Request a new one →</a></p>
    {% endif %}
  </div>
</main>
{% endblock %}

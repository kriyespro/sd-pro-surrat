{% extends 'base.jinja' %}
{% block title %}Freelancer Profile{% endblock %}
{% block meta_desc %}View freelancer profile{% endblock %}

{% block extra_head %}
<style>
    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      font-weight: 900
    }

    .logo span {
      color: var(--gold)
    }

    .tag {
      background: rgba(45, 115, 112, 0.12);
      color: var(--teal);
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      font-size: 0.72rem;
      border: 1px solid rgba(45, 115, 112, 0.22)
    }
    html.theme-dark .tag {
      background: rgba(13, 110, 110, 0.18);
      color: #7FCFCF;
      border-color: rgba(13, 110, 110, 0.32)
    }

    .tab {
      padding: 0.65rem 1.2rem;
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: all 0.2s
    }

    .tab.active {
      color: var(--gold);
      border-bottom-color: var(--gold)
    }

    .review-card {
      background: var(--dark2);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.2rem
    }

    .portfolio-item {
      border-radius: 12px;
      overflow: hidden;
      background: var(--dark2);
      border: 1px solid var(--border);
      cursor: pointer;
      transition: all 0.3s
    }

    .portfolio-item:hover {
      border-color: var(--border-gold);
      transform: translateY(-3px)
    }

    .portfolio-thumb {
      height: 160px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem
    }

    .sec-tag {
      font-family: 'Space Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--gold);
      display: block;
      margin-bottom: 0.5rem
    }

    .profile-stats { display: grid; grid-template-columns: repeat(4,1fr); margin-bottom: 2rem; }
    .profile-layout { display: grid; grid-template-columns: 1fr 320px; gap: 2rem; }
    .profile-portfolio-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    @media (max-width: 900px) {
      .profile-stats { grid-template-columns: repeat(2, 1fr); }
      .profile-stats > div:nth-child(2n) { border-right: none !important; }
      .profile-stats > div:nth-child(n+3) { border-top: 1px solid var(--border); }
      .profile-layout { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .profile-portfolio-grid { grid-template-columns: 1fr; }
      .profile-header-row { flex-direction: column; align-items: flex-start !important; }
    }
</style>
{% endblock %}

{% block nav %}
  {% include 'components/nav.jinja' %}
{% endblock %}

{% block content %}
<div x-data="{tab:'about', saved:false}">

  <!-- HERO BANNER -->
  <div style="height:160px;background:linear-gradient(135deg,#062E2E,#0D6E6E,#0A4040);position:relative;overflow:hidden">
    <svg style="position:absolute;inset:0;width:100%;height:100%" viewBox="0 0 1200 160" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <!-- Geometric diamond grid -->
      <defs>
        <pattern id="diamond-grid" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
          <polygon points="30,2 58,30 30,58 2,30" fill="none" stroke="rgba(232,168,48,0.08)" stroke-width="1"/>
          <polygon points="30,12 48,30 30,48 12,30" fill="none" stroke="rgba(232,168,48,0.05)" stroke-width="0.8"/>
        </pattern>
        <radialGradient id="glow-left" cx="20%" cy="50%" r="50%">
          <stop offset="0%" stop-color="rgba(13,110,110,0.55)"/>
          <stop offset="100%" stop-color="rgba(13,110,110,0)"/>
        </radialGradient>
        <radialGradient id="glow-right" cx="85%" cy="50%" r="40%">
          <stop offset="0%" stop-color="rgba(232,168,48,0.18)"/>
          <stop offset="100%" stop-color="rgba(232,168,48,0)"/>
        </radialGradient>
      </defs>
      <rect width="1200" height="160" fill="url(#diamond-grid)"/>
      <rect width="1200" height="160" fill="url(#glow-left)"/>
      <rect width="1200" height="160" fill="url(#glow-right)"/>
      <!-- Floating accent diamonds -->
      <polygon points="80,20 104,44 80,68 56,44" fill="none" stroke="rgba(232,168,48,0.22)" stroke-width="1.2"/>
      <polygon points="1100,30 1124,54 1100,78 1076,54" fill="none" stroke="rgba(232,168,48,0.18)" stroke-width="1"/>
      <polygon points="600,10 630,40 600,70 570,40" fill="none" stroke="rgba(232,168,48,0.12)" stroke-width="1.5"/>
      <!-- Subtle horizontal scan line -->
      <rect x="0" y="79" width="1200" height="1" fill="rgba(232,168,48,0.06)"/>
      <!-- SP monogram watermark -->
      <text x="50%" y="58%" dominant-baseline="middle" text-anchor="middle" font-family="Playfair Display,serif" font-size="72" font-weight="900" fill="rgba(232,168,48,0.04)" letter-spacing="8">SURATPRO</text>
    </svg>
  </div>

  <div style="max-width:1100px;margin:0 auto;padding:0 5% 4rem">
    <!-- Profile Header -->
    <div style="display:flex;gap:1.5rem;align-items:flex-end;margin-top:-55px;margin-bottom:1.8rem;flex-wrap:wrap">
      <!-- Avatar -->
      <div style="position:relative;flex-shrink:0">
        <div style="width:110px;height:110px;border-radius:50%;background:linear-gradient(135deg,#0D6E6E,#E8A830);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:2.2rem;font-weight:700;color:var(--dark);border:4px solid var(--dark)">{{ profile_user.initials }}</div>
        <div style="position:absolute;bottom:4px;right:4px;width:18px;height:18px;border-radius:50%;background:var(--green);border:2px solid var(--dark)"></div>
      </div>
      <!-- Info -->
      <div style="flex:1;min-width:220px;padding-bottom:0.4rem">
        <div style="display:flex;align-items:center;gap:0.7rem;flex-wrap:wrap;margin-bottom:0.3rem">
          <h1 style="font-family:'Playfair Display',serif;font-size:1.75rem;font-weight:900;line-height:1">{{ profile_user.get_full_name() or profile_user.username }}</h1>
          <span style="background:rgba(62,202,143,0.15);color:var(--green);border:1px solid rgba(62,202,143,0.3);padding:0.18rem 0.6rem;border-radius:100px;font-size:0.7rem;font-weight:700">🟢 {{ 'Online' if freelancer_profile and freelancer_profile.availability == 'available' else 'Available' }}</span>
          <span style="background:var(--gold-dim);border:1px solid var(--border-gold);color:var(--gold);padding:0.18rem 0.6rem;border-radius:100px;font-size:0.7rem;font-weight:700">✅ Top Rated</span>
        </div>
        <p style="color:var(--text-muted);font-size:0.92rem;margin-bottom:0.45rem">{{ freelancer_profile.title if freelancer_profile else profile_user.role|title }} · {{ profile_user.city }}</p>
        <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
          <span style="font-size:0.8rem;color:var(--text-muted)">★★★★★ <strong style="color:var(--white)">{{ freelancer_profile.avg_rating if freelancer_profile else '0.0' }}</strong> ({{ freelancer_profile.total_reviews if freelancer_profile else 0 }} reviews)</span>
          <span style="font-size:0.8rem;color:var(--text-muted)">📍 {{ profile_user.city }}</span>
          <span style="font-size:0.8rem;color:var(--text-muted)">🏆 {{ freelancer_profile.jobs_completed if freelancer_profile else 0 }} jobs done</span>
          <span style="font-size:0.8rem;color:var(--text-muted)">⏱ {{ freelancer_profile.response_time if freelancer_profile else '~1 hour' }}</span>
        </div>
      </div>
      <!-- Action buttons -->
      <div style="display:flex;gap:0.7rem;align-items:center;padding-bottom:0.4rem;flex-wrap:wrap">
        <button @click="saved=!saved" class="btn-outline" x-text="saved ? '♥ Saved' : '♡ Save'"></button>
        <a href="/messages/" class="btn-outline">💬 Message</a>
        <a href="/jobs/post/" class="btn-gold">Hire {{ profile_user.first_name or profile_user.username }} →</a>
      </div>
    </div>

    <!-- Rate + Stats strip -->
    <div class="card profile-stats">
      <div style="padding:1.2rem 1.5rem;border-right:1px solid var(--border);text-align:center">
        <div style="font-family:'Space Mono',monospace;font-size:1.5rem;color:var(--gold);font-weight:700">₹{{ freelancer_profile.hourly_rate if freelancer_profile else 0 }}</div>
        <div style="font-size:0.75rem;color:var(--text-muted)">per hour</div>
      </div>
      <div style="padding:1.2rem 1.5rem;border-right:1px solid var(--border);text-align:center">
        <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:900;color:var(--white)">{{ freelancer_profile.jobs_completed if freelancer_profile else 0 }}</div>
        <div style="font-size:0.75rem;color:var(--text-muted)">Jobs Completed</div>
      </div>
      <div style="padding:1.2rem 1.5rem;border-right:1px solid var(--border);text-align:center">
        <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:900;color:var(--green)">{{ freelancer_profile.success_rate if freelancer_profile else 0 }}%</div>
        <div style="font-size:0.75rem;color:var(--text-muted)">Success Rate</div>
      </div>
      <div style="padding:1.2rem 1.5rem;text-align:center">
        <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:900;color:var(--white)">{{ freelancer_profile.experience_years if freelancer_profile else 0 }} yrs
        </div>
        <div style="font-size:0.75rem;color:var(--text-muted)">Experience</div>
      </div>
    </div>

    <div class="profile-layout">
      <!-- LEFT -->
      <div>
        <!-- Tabs -->
        <div style="display:flex;border-bottom:1px solid var(--border);margin-bottom:1.5rem">
          <button class="tab" :class="{active:tab==='about'}" @click="tab='about'">About</button>
          <button class="tab" :class="{active:tab==='portfolio'}" @click="tab='portfolio'">Portfolio</button>
          <button class="tab" :class="{active:tab==='reviews'}" @click="tab='reviews'">Reviews (98)</button>
        </div>

        <!-- ABOUT -->
        <div x-show="tab==='about'">
          <span class="sec-tag">// Bio</span>
          <p style="color:var(--text-muted);line-height:1.75;font-size:0.92rem;margin-bottom:1.5rem">{{ profile_user.bio }}</p>

          <span class="sec-tag">// Skills</span>
          <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.5rem">
            {% if freelancer_profile %}
              {% for s in freelancer_profile.skills.all() %}
                <span class="tag">{{ s.name }}</span>
              {% endfor %}
            {% endif %}
          </div>

          <span class="sec-tag">// Languages</span>
          <div style="display:flex;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap">
            <span style="font-size:0.85rem;color:var(--text-muted)">🇬🇧 English — <strong
                style="color:var(--white)">Fluent</strong></span>
            <span style="font-size:0.85rem;color:var(--text-muted)">🇮🇳 Gujarati — <strong
                style="color:var(--white)">Native</strong></span>
            <span style="font-size:0.85rem;color:var(--text-muted)">🇮🇳 Hindi — <strong
                style="color:var(--white)">Fluent</strong></span>
          </div>

          <span class="sec-tag">// Education</span>
          <div class="card" style="padding:1.2rem;margin-bottom:1.5rem">
            <div style="font-weight:600">B.Tech in Computer Science</div>
            <div style="font-size:0.82rem;color:var(--text-muted)">SVNIT Surat · 2015–2019</div>
          </div>

          <span class="sec-tag">// Certifications</span>
          <div style="display:flex;flex-direction:column;gap:0.6rem">
            {% for cert in certifications %}
            <div class="card" style="padding:1rem;display:flex;gap:0.8rem;align-items:center">
              <span style="font-size:1.3rem">🏅</span>
              <div>
                <div style="font-size:0.88rem;font-weight:600">{{ cert.title }}</div>
                <div style="font-size:0.75rem;color:var(--text-muted)">{{ cert.issuer }} · {{ cert.year }}</div>
              </div>
            </div>
            {% endfor %}
          </div>
        </div>

        <!-- PORTFOLIO -->
        <div x-show="tab==='portfolio'" class="profile-portfolio-grid">
          {% for p in portfolio_items %}
          <div class="portfolio-item">
            <div class="portfolio-thumb" style="background:linear-gradient(135deg,var(--mid2),var(--mid))"><span>💼</span></div>
            <div style="padding:1rem">
              <div style="font-weight:600;font-size:0.9rem;margin-bottom:0.3rem">{{ p.title }}</div>
              <div style="font-size:0.78rem;color:var(--text-muted);margin-bottom:0.7rem">{{ p.description }}</div>
            </div>
          </div>
          {% endfor %}
        </div>

        <!-- REVIEWS -->
        <div x-show="tab==='reviews'" style="display:flex;flex-direction:column;gap:1rem">
          <template
            x-for="r in [{name:'Sanjay Mehta',role:'Director, Mehta Textiles',avatar:'SM',color:'linear-gradient(135deg,#0D6E6E,#E8A830)',rating:5,date:'2 weeks ago',text:'Karan delivered the project ahead of schedule. Clean code, great communication, and deep technical skills. Highly recommend!'},{name:'Hetal Raval',role:'Owner, Raval Jewels',avatar:'HR',color:'linear-gradient(135deg,#8B5CF6,#3ECA8F)',rating:5,date:'1 month ago',text:'Built our inventory system from scratch. Very professional, understood Surat business needs perfectly.'},{name:'Dhara Kapadia',role:'Co-founder, StyleSurat',avatar:'DK',color:'linear-gradient(135deg,#E85D04,#E8A830)',rating:5,date:'2 months ago',text:'Excellent React developer. Fixed critical bugs and added new features within tight deadlines. Will hire again.'}]">
            <div class="review-card">
              <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.8rem">
                <div
                  style="width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:0.85rem;font-weight:700;color:var(--dark);flex-shrink:0"
                  :style="'background:'+r.color" x-text="r.avatar"></div>
                <div style="flex:1">
                  <div style="font-weight:600;font-size:0.88rem" x-text="r.name"></div>
                  <div style="font-size:0.72rem;color:var(--text-muted)" x-text="r.role"></div>
                </div>
                <div style="text-align:right">
                  <div style="color:var(--gold);font-size:0.75rem">★★★★★</div>
                  <div style="font-size:0.7rem;color:var(--text-dim)" x-text="r.date"></div>
                </div>
              </div>
              <p style="font-size:0.85rem;color:var(--text-muted);line-height:1.6;font-style:italic"
                x-text="'\"'+r.text+' \"'"></p>
            </div>
          </template>
        </div>
      </div>

      <!-- RIGHT SIDEBAR -->
      <div style="display:flex;flex-direction:column;gap:1.2rem">
        <!-- Hire Card -->
        <div class="card" style="padding:1.5rem">
          <div style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;margin-bottom:1rem">Quick
            Hire</div>
          <div
            style="display:flex;flex-direction:column;gap:0.8rem;margin-bottom:1.2rem;font-size:0.85rem;color:var(--text-muted)">
            <div style="display:flex;justify-content:space-between"><span>Hourly Rate</span><strong
                style="color:var(--gold);font-family:'Space Mono',monospace">₹{{ freelancer_profile.hourly_rate if freelancer_profile else 0 }}/hr</strong></div>
            <div style="display:flex;justify-content:space-between"><span>Min. Project</span><strong
                style="color:var(--white)">₹{{ freelancer_profile.min_project if freelancer_profile else 0 }}</strong></div>
            <div style="display:flex;justify-content:space-between"><span>Availability</span><strong
                style="color:var(--green)">🟢 Available</strong></div>
            <div style="display:flex;justify-content:space-between"><span>Response Time</span><strong
                style="color:var(--white)">{{ freelancer_profile.response_time if freelancer_profile else '~1 hour' }}</strong></div>
          </div>
          <a href="/jobs/post/" class="btn-gold" style="width:100%;justify-content:center;margin-bottom:0.7rem">Hire
            {{ profile_user.first_name or profile_user.username }} →</a>
          <a href="/messages/" class="btn-outline"
            style="width:100%;justify-content:center;text-align:center;display:block">Send Message</a>
        </div>

        <!-- Verified Badge -->
        <div class="card" style="padding:1.2rem">
          <div
            style="font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);margin-bottom:0.8rem;font-family:'Space Mono',monospace">
            // Verified</div>
          <div style="display:flex;flex-direction:column;gap:0.5rem;font-size:0.82rem">
            <div style="color:var(--green)">✅ Aadhaar Verified</div>
            <div style="color:var(--green)">✅ Phone Verified</div>
            <div style="color:var(--green)">✅ Portfolio Verified</div>
            <div style="color:var(--green)">✅ Bank Account Linked</div>
          </div>
        </div>

        <!-- Similar Freelancers -->
        <div class="card" style="padding:1.2rem">
          <div
            style="font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--gold);margin-bottom:0.8rem;font-family:'Space Mono',monospace">
            // Similar Talent</div>
          {% for s in similar_profiles %}
            <a href="/profile/{{ s.user.username }}/"
              style="display:flex;align-items:center;gap:0.7rem;padding:0.7rem 0;border-bottom:1px solid var(--border);text-decoration:none">
              <div
                style="width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:0.78rem;font-weight:700;color:var(--dark);flex-shrink:0;background:linear-gradient(135deg,#0D6E6E,#E8A830)">{{ s.user.initials }}</div>
              <div style="flex:1">
                <div style="font-size:0.85rem;font-weight:600;color:var(--white)">{{ s.user.get_full_name() or s.user.username }}</div>
                <div style="font-size:0.72rem;color:var(--text-muted)">{{ s.title }}</div>
              </div>
              <div style="font-size:0.75rem;color:var(--gold);font-family:'Space Mono',monospace">₹{{ s.hourly_rate }}/hr</div>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
